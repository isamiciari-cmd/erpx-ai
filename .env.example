# Browser configuration: only public Supabase values belong here.
# Copy to .env.local and fill from your own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional explicit local preview, only when no live Supabase config is present.
# Ignored in production builds and on non-loopback hosts.
VITE_DEMO_MODE=false
