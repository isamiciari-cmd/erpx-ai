# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Instructions:
# 1. Create a new Supabase project at https://supabase.com
# 2. Go to Project Settings > API
# 3. Copy the Project URL and paste it as VITE_SUPABASE_URL
# 4. Copy the anon/public key and paste it as VITE_SUPABASE_ANON_KEY
# 5. Rename this file to .env

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_ENV=development

# Developer Authentication Bypass (localhost/staging only)
# Set to 'true' to enable developer quick login for testing
# WARNING: Automatically disabled on production domain (erpx-ai.com)
# Developer account: i.1122@erpx-ai.com / @12345
VITE_DEV_AUTH_BYPASS=false
