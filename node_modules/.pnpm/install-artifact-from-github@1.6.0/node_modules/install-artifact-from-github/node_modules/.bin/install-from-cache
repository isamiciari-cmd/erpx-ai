#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspaces/default/code/node_modules/.pnpm/install-artifact-from-github@1.6.0/node_modules/install-artifact-from-github/bin/node_modules:/workspaces/default/code/node_modules/.pnpm/install-artifact-from-github@1.6.0/node_modules/install-artifact-from-github/node_modules:/workspaces/default/code/node_modules/.pnpm/install-artifact-from-github@1.6.0/node_modules:/workspaces/default/code/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspaces/default/code/node_modules/.pnpm/install-artifact-from-github@1.6.0/node_modules/install-artifact-from-github/bin/node_modules:/workspaces/default/code/node_modules/.pnpm/install-artifact-from-github@1.6.0/node_modules/install-artifact-from-github/node_modules:/workspaces/default/code/node_modules/.pnpm/install-artifact-from-github@1.6.0/node_modules:/workspaces/default/code/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/install-from-cache.js" "$@"
else
  exec node  "$basedir/../../bin/install-from-cache.js" "$@"
fi
