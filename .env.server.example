# SERVER ONLY. Copy to .env.server.local, which is ignored by git.
# Never prefix secrets with VITE_, include in frontend builds, or paste into chat.
# Supabase supplies its own URL/anon/service role values to deployed Edge Functions.
APP_SITE_URL=
# Initial local model. No automatic switch to a paid service.
AI_PROVIDER=ollama
AI_ALLOW_PAID_PROVIDER=false
# An authenticated HTTPS gateway to your running local model. Never raw Ollama.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3:1.7b
# Future optional hosted upgrade: requires AI_PROVIDER=openai AND
# AI_ALLOW_PAID_PROVIDER=true, plus the following two server secrets.
OPENAI_API_KEY=
# Choose an enabled Responses API model from your provider account.
OPENAI_MODEL=
# JSON keyed by real company UUID. Use simulation until acceptance testing passes.
# Example shape (not working credentials):
# {"company-uuid":{"environment":"simulation","binarySecurityToken":"...","secret":"..."}}
ZATCA_COMPANY_CREDENTIALS={}
# Set only in the local environment for authenticated CLI/DB deployment tooling.
SUPABASE_PROJECT_REF=
DATABASE_URL=

# Scoped Management API token for reviewed database inspection/migrations.
SUPABASE_ACCESS_TOKEN=
